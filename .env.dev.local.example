# Segredos de DESENVOLVIMENTO/TESTE do Utilar — NÃO versionado (.gitignore cobre .env*).
# Copie para .env.dev.local e preencha com CHAVES DE TESTE reais.
# O up.sh carrega este arquivo automaticamente. Ausente → placeholders dummy.
#
# ⚠️ Regra do dono: conta/chave DEDICADA do Utilar. Nunca reusar as do gifthy.

# --- PSP ativo (troca fácil entre gateways) ---
# stripe | appmax-v1 | mercadopago
PSP_PROVIDER=stripe

# --- Stripe (modo teste) ---
# A publishable key (pk_test_...) já está em app/.env.local; use a MESMA conta.
STRIPE_SECRET_KEY=sk_test_COLOQUE_A_SECRET_DE_TESTE_AQUI
STRIPE_WEBHOOK_SECRET=whsec_COLOQUE_O_WEBHOOK_SECRET_AQUI
STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Appmax v1 (quando o contrato/credenciais entrarem) ---
# APPMAX_ENV="APPMAX_ACCESS_TOKEN=... APPMAX_CLIENT_ID=... APPMAX_CLIENT_SECRET=..."
